# Besonc environment.
#
#   cp .env.example .env   and fill in the blanks.
#   .env is gitignored. NEVER commit it.
#
# Anything left blank runs in a safe development mode: SMS goes to an
# in-memory stub, payments are disabled, and Maps falls back to
# straight-line distance. Services SAY SO LOUDLY at startup — if a log line
# reads "IN-MEMORY STUB", no real message is being sent.
#
# In production (NODE_ENV=production) the guardrails are strict and a
# service will REFUSE TO START rather than run half-configured. See
# libs/platform/src/config/env.ts.

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Datastores — defaults match infra/docker/compose.dev.yml
# ---------------------------------------------------------------------
# Without DATABASE_URL every service keeps state in memory and loses it on
# restart. payment-svc REFUSES to start without it in production, because a
# lost ledger cannot be reconstructed.
DATABASE_URL=postgresql://besonc:besonc_dev@localhost:5432/besonc

# Without REDIS_URL, OTP rate limits are per-process and dispatch cannot
# arbitrate the accept race between replicas. dispatch-svc REFUSES to start
# without it in production — two riders would win the same order.
REDIS_URL=redis://localhost:6379

RABBITMQ_URL=amqp://besonc:besonc_dev@localhost:5672

# Object storage — proof-of-delivery photos, KYC documents, menu images.
# WITHOUT S3_ENDPOINT media-svc keeps an in-memory stub and DISCARDS every
# upload; a delivery dispute with no photo is unarguable, so the service
# REFUSES to start without this in production.
#
# Works with any SigV4 provider: AWS S3, Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces, Wasabi, or MinIO locally (`make s3-up`).
#   AWS  : https://s3.eu-west-1.amazonaws.com   region=eu-west-1
#   R2   : https://<account>.r2.cloudflarestorage.com   region=auto
#   MinIO: http://localhost:9000   region=us-east-1   FORCE_PATH_STYLE=true
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=besonc-media
S3_ACCESS_KEY=besonc
S3_SECRET_KEY=besonc_dev_secret
S3_REGION=us-east-1
# MinIO and other self-hosted gateways cannot virtual-host a bucket
# (`bucket.localhost` does not resolve). Leave true for MinIO, unset for AWS/R2.
S3_FORCE_PATH_STYLE=true
# CDN in front of the PUBLIC objects (menu photos only — private media is
# always served through a short-lived signed GET). Serving the home feed's
# images from the bucket origin means paying egress on every scroll.
S3_PUBLIC_BASE_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------
# These MUST differ from each other. Sharing one secret means a stolen
# access token can be replayed as a refresh token, defeating rotation.
# Generate with:  openssl rand -base64 48
# In production: minimum 32 chars, and known placeholders are rejected.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Development only. Returns the OTP code in the API response so you can log
# in without a real SMS. IGNORED when NODE_ENV=production.
EXPOSE_OTP_CODES=false

# ---------------------------------------------------------------------
# Hubtel SMS — primary OTP channel
# ---------------------------------------------------------------------
# All three must be set together; a half-configured provider looks fine
# until the first OTP and then fails.
# HUBTEL_SENDER_ID must be pre-approved by Hubtel and is capped at 11
# characters by the GSM standard — a longer one is rejected at startup
# rather than silently never arriving.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=

# Optional failover. Ghanaian SMS routes degrade regularly and an
# undelivered OTP is a customer who cannot sign in at all.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=

# ---------------------------------------------------------------------
# Paystack
# ---------------------------------------------------------------------
# Must start sk_test_ or sk_live_. A sk_test_ key with NODE_ENV=production
# is refused at startup: real customers would be charged against a test
# account. Pasting a pk_ key here is also caught.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional. Paystack signs webhooks with the secret key unless you set a
# separate signing secret in the dashboard.
PAYSTACK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Google Maps — use RESTRICTED keys, one per platform
# ---------------------------------------------------------------------
# The server key should be IP-restricted; the mobile keys should be
# restricted by app signature. An unrestricted key found in an APK gets
# scraped and billed to you.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_WEB_KEY=

# ---------------------------------------------------------------------
# Firebase push
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------
# Service discovery — defaults are correct for run-stack.sh on one machine
# ---------------------------------------------------------------------
SVC_IDENTITY_URL=http://127.0.0.1:3001
SVC_CATALOGUE_URL=http://127.0.0.1:3002
SVC_ORDER_URL=http://127.0.0.1:3003
SVC_PRICING_URL=http://127.0.0.1:3004
SVC_DISPATCH_URL=http://127.0.0.1:3005
SVC_TRACKING_URL=http://127.0.0.1:3006
SVC_PAYMENT_URL=http://127.0.0.1:3007
BFF_CUSTOMER_URL=http://127.0.0.1:3101
BFF_VENDOR_URL=http://127.0.0.1:3102
BFF_RIDER_URL=http://127.0.0.1:3103
BFF_ADMIN_URL=http://127.0.0.1:3104

# ---------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------
PORT=3000
# Only enable behind a load balancer YOU control. If this is true and the
# port is reachable directly, any client can spoof X-Forwarded-For and walk
# through the anonymous rate limit.
TRUST_PROXY=false
CORS_ORIGINS=
UPSTREAM_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# Launch scope (MASTER_PLAN §4.3) — Food + Parcel first
# ---------------------------------------------------------------------
FEATURE_FOOD=true
FEATURE_PARCEL=true
FEATURE_GROCERIES=false
FEATURE_MARKET=false
FEATURE_SHOP=false
FEATURE_PHARMACY=false
FEATURE_LAUNDRY=false
FEATURE_ERRAND=false
