# Copy to .env and fill in. NEVER commit .env.
# The agent will ask you before any real key is needed.

NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores (local dev defaults from compose.dev.yml) ---
DATABASE_URL=postgresql://besonc:besonc_dev@localhost:5432/payment
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://besonc:besonc_dev@localhost:5672
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=besonc
S3_SECRET_KEY=besonc_dev_secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Auth ---
JWT_ACCESS_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Hubtel SMS (Sprint 2) ---
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=

# --- Google Maps (Sprint 3) — use restricted keys, one per platform ---
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_WEB_KEY=

# --- Paystack (Sprint 6 test / Sprint 17 live) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Firebase (Sprint 11) ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
